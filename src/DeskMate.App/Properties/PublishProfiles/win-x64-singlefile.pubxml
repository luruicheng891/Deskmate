<?xml version="1.0" encoding="utf-8"?>
<!--
  发布配置：self-contained 单文件（win-x64）。
  用法：dotnet publish src/DeskMate.App/DeskMate.App.csproj -p:PublishProfile=win-x64-singlefile

  已在本机实测（.NET 8.0.425 / Windows 10 22631）的注意事项：
  1. WPF 的 5 个原生库（wpfgfx_cor3、PresentationNative_cor3、PenImc_cor3、
     D3DCompiler_47_cor3、vcruntime140_cor3）无法进入 bundle，会以独立 dll 留在 exe 旁边。
     若一定要「真·单个 exe」，改用 <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>，
     代价是首次启动要把 ~160MB 原生库解压到 %TEMP%，与「启动 < 2 秒」冲突，故默认不启用。
  2. 不设 EnableCompressionInSingleFile：单文件压缩会在启动时全量解压内存中的托管程序集，
     同样吃启动预算；换来的是体积从 ~133MB 降到约一半。体积优先时再打开。
  3. 保留 pdb：全局异常日志需要行号。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>AnyCPU</Platform>
    <PublishProfile>win-x64-singlefile</PublishProfile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 预编译成 R2R 镜像，省掉启动时的 JIT；实测能把冷启动压下来一档。 -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <PublishDir>..\..\artifacts\DeskMate\</PublishDir>
  </PropertyGroup>
</Project>
