<Window x:Class="DeskMate.App.Views.TextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskMate 输入"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <!--
      Dock 图标只有 30~80 像素，没有地方放浮层，所以改名这类输入用一个小模态框。
      这是「需要用户拿主意」的场合，模态框在这里是合适的。
    -->
    <Border Margin="18"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.3" Direction="270" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource SectionTextStyle}" />
            <TextBlock x:Name="PromptText"
                       Style="{StaticResource CaptionTextStyle}"
                       Margin="0,6,0,12"
                       TextWrapping="Wrap" />
            <TextBox x:Name="InputBox"
                     Style="{StaticResource FieldTextBoxStyle}"
                     MaxLength="40" />
            <TextBlock x:Name="ErrorText"
                       Foreground="{DynamicResource InvalidBrush}"
                       FontSize="12"
                       MinHeight="18"
                       Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="取消"
                        Style="{StaticResource GhostButtonStyle}"
                        IsCancel="True"
                        Click="OnCancel" />
                <Button x:Name="OkButton"
                        Content="确定"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="10,0,0,0"
                        IsDefault="True"
                        Click="OnAccept" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
