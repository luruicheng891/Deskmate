<Window x:Class="DeskMate.App.Views.TaskbarBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskMate 任务栏"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeToContent="Width"
        Height="40">

    <Window.Resources>
        <!-- 悬停提亮的控件底座：与 Dock 的图标按钮同一手感。 -->
        <Style x:Key="BarWidgetStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BarIconStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </Window.Resources>

    <!--
      右下角小条：只装系统托盘那一套（输入法 · 网络 · 音量 · 时钟）。
      完全透明：没有背景板与描边，只有控件本体浮在桌面上，空白处点击直接穿透到下层窗口；
      每个控件自己带悬停高亮（BarWidgetStyle），鼠标扫过去才知道边界在哪。
    -->
    <Border Background="{x:Null}"
            BorderThickness="0">
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="4,0,4,0"
                    Height="32">

            <!-- 输入法状态：中/英，单击切换 -->
            <Border x:Name="ImeHost"
                    Style="{StaticResource BarWidgetStyle}"
                    Width="36"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnImeClick">
                <TextBlock x:Name="ImeText"
                           Text="英"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <!-- 音量：滚轮调节，单击静音 -->
            <Border x:Name="VolumeHost"
                    Style="{StaticResource BarWidgetStyle}"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnVolumeClick"
                    MouseWheel="OnVolumeWheel">
                <Grid Width="20" Height="18" VerticalAlignment="Center">
                    <Path Data="M2,6.2 H5.4 L9.6,2.4 V15.6 L5.4,11.8 H2 Z"
                          Fill="{DynamicResource TextPrimaryBrush}" />
                    <Path x:Name="VolumeWave"
                          Data="M12.4,5.6 C14.6,6.8 14.6,11.2 12.4,12.4 M15,3.4 C18.6,6 18.6,12 15,14.6"
                          Style="{StaticResource BarIconStyle}" />
                    <Path x:Name="VolumeMuteX"
                          Data="M12.6,6.4 L17.4,11.6 M17.4,6.4 L12.6,11.6"
                          Style="{StaticResource BarIconStyle}"
                          Stroke="{DynamicResource InvalidBrush}"
                          Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- 网络：Wi-Fi 弧线（按信号强度提亮）/ 有线图标；单击打开系统网络设置 -->
            <Border x:Name="NetworkHost"
                    Style="{StaticResource BarWidgetStyle}"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnNetworkClick">
                <Grid Width="20" Height="18" VerticalAlignment="Center">
                    <Grid x:Name="WifiIcon">
                        <Path x:Name="WifiArc1"
                              Data="M6.4,11.2 A4.8,4.8 0 0,1 13.6,11.2"
                              Style="{StaticResource BarIconStyle}" />
                        <Path x:Name="WifiArc2"
                              Data="M3.8,8.4 A7.8,7.8 0 0,1 16.2,8.4"
                              Style="{StaticResource BarIconStyle}" />
                        <Path x:Name="WifiArc3"
                              Data="M1.2,5.6 A10.6,10.6 0 0,1 18.8,5.6"
                              Style="{StaticResource BarIconStyle}" />
                        <Ellipse Width="3.2" Height="3.2"
                                 Fill="{DynamicResource TextPrimaryBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,1.6" />
                    </Grid>
                    <Grid x:Name="WiredIcon" Visibility="Collapsed">
                        <Path Data="M3.5,4.5 H16.5 V10 H3.5 Z"
                              Style="{StaticResource BarIconStyle}" />
                        <Path Data="M10,10 V12.2"
                              Style="{StaticResource BarIconStyle}" />
                        <Ellipse Width="3" Height="3"
                                 Fill="{DynamicResource TextPrimaryBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,1.6" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 时间与日期：两行右对齐，与系统任务栏的摆法一致 -->
            <Border x:Name="ClockHost" Style="{StaticResource BarWidgetStyle}" MinWidth="66">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ClockTimeText"
                               Text="--:--"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Right" />
                    <TextBlock x:Name="ClockDateText"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Right"
                               Margin="0,1,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</Window>
