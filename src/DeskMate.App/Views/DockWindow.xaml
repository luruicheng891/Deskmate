<Window x:Class="DeskMate.App.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DeskMate.App.Controls"
        Title="DeskMate Dock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True">

    <Window.Resources>
        <ItemsPanelTemplate x:Key="HorizontalDockPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="VerticalDockPanel">
            <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>

        <!-- 容器只负责间距；让位用的 TranslateTransform 由代码逐个容器新建（见 ShiftNeighbors），
             不能写在这里：样式里的 Freezable 会被冻结并被所有容器共用一份。 -->
        <Style x:Key="HorizontalContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style x:Key="VerticalContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <DataTemplate x:Key="DockItemTemplate">
            <controls:DockItemControl />
        </DataTemplate>

        <!-- Dock 两端的固定按钮：启动台入口与添加入口。动效只改 RenderTransform，避免重排掉帧。 -->
        <Style x:Key="DockBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,1" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Halo"
                                     Fill="{DynamicResource SurfaceHoverBrush}"
                                     Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.2" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.2" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.14" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.14" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>

        <!-- 背景与阴影单独一层：Effect 会作用于整个子树，放进内容层会把图标一起糊掉。 -->
        <Border x:Name="Backdrop"
                Margin="8"
                CornerRadius="16"
                Background="{DynamicResource DockBackgroundBrush}" />

        <Border x:Name="Chrome"
                Margin="8"
                Padding="8,6"
                AllowDrop="True"
                Background="Transparent"
                Drop="OnChromeDrop"
                DragOver="OnChromeDragOver"
                DragEnter="OnChromeDragEnter"
                DragLeave="OnChromeDragLeave">
            <StackPanel x:Name="RootStrip" Orientation="Horizontal">

                <!-- 最左：启动台 -->
                <Button x:Name="LauncherButton"
                        Style="{StaticResource DockBarButtonStyle}"
                        ToolTip="启动台（全部应用与搜索）"
                        Click="OnLauncherButtonClick">
                    <Viewbox Width="{Binding IconSize}" Height="{Binding IconSize}" Margin="4">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="1" Canvas.Top="1" Width="10" Height="10" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource AccentBrush}" />
                            <Rectangle Canvas.Left="13" Canvas.Top="1" Width="10" Height="10" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource AccentBrush}" Opacity="0.75" />
                            <Rectangle Canvas.Left="1" Canvas.Top="13" Width="10" Height="10" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource AccentBrush}" Opacity="0.75" />
                            <Rectangle Canvas.Left="13" Canvas.Top="13" Width="10" Height="10" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource AccentBrush}" Opacity="0.5" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- 左端第二个：文件夹管理。DeskMate 只引用路径，不移动任何文件 -->
                <Button x:Name="FolderButton"
                        Style="{StaticResource DockBarButtonStyle}"
                        ToolTip="文件夹管理（只引用路径，不会移动或改名你桌面上的任何文件）"
                        Click="OnFolderButtonClick">
                    <Viewbox Width="{Binding IconSize}" Height="{Binding IconSize}" Margin="4">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="2" Canvas.Top="3.5" Width="9" Height="4.5" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource AccentBrush}" />
                            <Rectangle Canvas.Left="2" Canvas.Top="7" Width="20" Height="13" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource AccentBrush}" Opacity="0.8" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <ItemsControl x:Name="ItemsHost"
                              Margin="4,0"
                              ItemTemplate="{StaticResource DockItemTemplate}"
                              ItemsPanel="{StaticResource HorizontalDockPanel}"
                              ItemContainerStyle="{StaticResource HorizontalContainerStyle}"
                              ItemsSource="{Binding Items}"
                              Background="Transparent"
                              Focusable="False" />

                <!-- 最右：添加 -->
                <Button x:Name="AddButton"
                        Style="{StaticResource DockBarButtonStyle}"
                        ToolTip="添加：打开启动台后右键图标选「添加到 Dock」，也可以直接把 .exe / 快捷方式 / 文件夹拖到这条 Dock 上。图标右键还能改名、换图标、重新选择目标。"
                        Click="OnAddButtonClick">
                    <Viewbox Width="{Binding IconSize}" Height="{Binding IconSize}" Margin="4">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="2" Canvas.Top="10.5" Width="20" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource TextPrimaryBrush}" />
                            <Rectangle Canvas.Left="10.5" Canvas.Top="2" Width="3" Height="20" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource TextPrimaryBrush}" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>
        </Border>

        <!--
          拖拽排序时的插入位置指示线。位置全靠 RenderTransform 改，元素本身不参与布局，
          所以拖的时候不会引起任何重排（改 Margin 会，那是这条 Dock 一直在避免的）。
        -->
        <Rectangle x:Name="DropIndicator"
                   Width="2"
                   Height="34"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   RadiusX="1"
                   RadiusY="1"
                   Fill="{DynamicResource AccentBrush}"
                   Visibility="Collapsed"
                   IsHitTestVisible="False" />
    </Grid>
</Window>
