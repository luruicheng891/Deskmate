<Window x:Class="DeskMate.App.Views.FilePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DeskMate.App.Controls"
        Title="DeskMate 文件预览"
        Width="1080"
        Height="760"
        MinWidth="520"
        MinHeight="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        MouseLeftButtonDown="OnDragMove"
        KeyDown="OnKeyDown">

    <!--
      放大窗口：右侧那一栏只有 420 DIP，长文与 PDF 在里面读着累。
      内容和窄栏共用 FilePreviewControl，所以两处看到的排版一定一致；DataContext 也是同一个视图模型，
      在这里翻到第 8 页，窄栏也停在第 8 页。
    -->
    <Border Margin="16"
            Padding="20,14"
            CornerRadius="16"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.32" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right"
                        Content="&#xE711;"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="关闭（Esc）"
                        Click="OnCloseClick" />
                <Button DockPanel.Dock="Right"
                        Content="&#xE838;"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="在资源管理器中显示"
                        Command="{Binding RevealCommand}" />
                <Button DockPanel.Dock="Right"
                        Content="&#xE8E5;"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="用默认程序打开（预览只是看，改不了它）"
                        Command="{Binding OpenCommand}" />

                <!-- 文件名与大小那两行由下面的 FilePreviewControl 自己画（窄栏里也有），这里只补一句它在哪 -->
                <TextBlock VerticalAlignment="Center"
                           FontSize="11.5"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding DirectoryPath}" />
            </DockPanel>

            <controls:FilePreviewControl Grid.Row="1" DataContext="{Binding}" />
        </Grid>
    </Border>
</Window>
