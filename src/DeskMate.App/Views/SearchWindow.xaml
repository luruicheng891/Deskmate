<Window x:Class="DeskMate.App.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskMate 搜索"
        Width="600"
        SizeToContent="Height"
        MaxHeight="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">

    <Grid Margin="18">
        <!-- 阴影单独一层，Effect 会影响子树，放进内容层会把文字一起糊掉 -->
        <Border x:Name="Backdrop"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.35" Direction="270" />
            </Border.Effect>
        </Border>

        <Border x:Name="Panel"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PanelScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>

            <DockPanel>
                <!-- 输入行 -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource SurfaceBrush}"
                        Padding="16,13">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="17"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <TextBox x:Name="InputBox"
                                 Style="{StaticResource SearchBoxStyle}"
                                 FontSize="19"
                                 Text="{Binding Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </Border>

                <!-- 底部提示 -->
                <Border DockPanel.Dock="Bottom"
                        Background="{DynamicResource SurfaceBrush}"
                        Padding="16,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 零结果时必须给出路：只写一句「没有匹配」，用户既不知道能不能搜文件，也不知道下一步做什么 -->
                            <Button Content="重新扫描应用"
                                    Style="{StaticResource GhostButtonStyle}"
                                    FontSize="12"
                                    Padding="10,4"
                                    Margin="0,0,8,0"
                                    ToolTip="刚装的软件没出现在这里时，扫一次就好，不用重启 DeskMate"
                                    Command="{Binding RequestRescanCommand}"
                                    Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}" />
                            <Button Content="在资源管理器中搜索"
                                    Style="{StaticResource GhostButtonStyle}"
                                    FontSize="12"
                                    Padding="10,4"
                                    ToolTip="全盘内容检索交给 Windows 索引，DeskMate 不自己再造一套"
                                    Command="{Binding SearchWithSystemCommand}"
                                    Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Hint}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="↑↓ 选择　·　Enter 打开　·　Ctrl+Enter 打开位置　·　右键更多　·　Esc 关闭"
                                   Style="{StaticResource CaptionTextStyle}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource ThinScrollViewerStyle}">
                    <ItemsControl x:Name="ResultsHost"
                                  ItemsSource="{Binding Results}"
                                  Background="Transparent">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="8,2"
                                        Padding="10,8"
                                        CornerRadius="9"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="OnResultClick">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Border.ContextMenu>
                                        <ContextMenu MinWidth="180"
                                                     Opened="OnResultMenuOpened"
                                                     Closed="OnResultMenuClosed">
                                            <MenuItem Header="打开" Command="{Binding OpenCommand}" />
                                            <MenuItem Header="在资源管理器中显示" Command="{Binding RevealCommand}" />
                                            <MenuItem Header="复制路径" Command="{Binding CopyPathCommand}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <DockPanel>
                                        <Border DockPanel.Dock="Right"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="7"
                                                Padding="7,2">
                                            <TextBlock Text="{Binding TypeLabel}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>

                                        <Grid Width="30" Height="30" Margin="0,0,11,0">
                                            <Image Source="{Binding Icon}"
                                                   Stretch="Uniform"
                                                   Visibility="{Binding Icon, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                                            <TextBlock Text="{Binding Title, Converter={StaticResource FirstLetter}}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding Icon, Converter={StaticResource NullToVis}}" />
                                        </Grid>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="430"
                                                       HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
