<Window x:Class="DeskMate.App.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 DeskMate"
        Width="560"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <!--
      首次启动的欢迎窗。以前只有一个「要不要导入桌面文件夹」的模态框，
      新用户看到的是一条空 Dock 和一个托盘图标，完全不知道下一步做什么。
    -->
    <Border Margin="18"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="26,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.32" Direction="270" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="欢迎使用 DeskMate" Style="{StaticResource TitleTextStyle}" />
            <TextBlock Style="{StaticResource CaptionTextStyle}"
                       Margin="0,6,0,18"
                       Text="DeskMate 只保存路径引用：不会移动、改名或删除你桌面上的任何文件。" />

            <TextBlock Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="① 往 Dock 上加东西：把 .exe、快捷方式或文件夹直接拖到底下那条 Dock 上；也可以从启动台右键图标选「添加到 Dock」。图标右键还能改名、换图标、重新选择目标。" />
            <TextBlock Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="② 找东西：按 Alt+Space 呼出搜索，能搜应用、文件夹、桌面文件和受管目录里的内容，支持拼音首字母。快捷键在设置里可以改，托盘菜单里也有「打开搜索」。" />
            <TextBlock Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,18"
                       Text="③ 整理桌面：文件夹管理面板里的「图片 / 文档 / 压缩包」是桌面的虚拟分类，双击就是打开，桌面上的文件一个都不会被挪走。" />

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12"
                    Visibility="{Binding DesktopVisibility}">
                <StackPanel>
                    <TextBlock Text="{Binding DesktopLine}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Margin="0,4,0,0"
                               Text="只会添加路径引用，桌面上的文件夹不会被移动或改名。以后想加，面板工具栏上一直有「扫描桌面文件夹」。" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="以后再说"
                        Style="{StaticResource GhostButtonStyle}"
                        IsCancel="True" />
                <Button Content="把这些文件夹加入管理"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="10,0,0,0"
                        Click="OnImport"
                        Visibility="{Binding ImportVisibility}" />
                <Button Content="开始使用"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="10,0,0,0"
                        Click="OnClose"
                        Visibility="{Binding CloseVisibility}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
