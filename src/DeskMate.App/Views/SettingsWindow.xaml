<Window x:Class="DeskMate.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskMate 设置"
        Width="840"
        Height="620"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        ShowInTaskbar="True"
        UseLayoutRounding="True">

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <StackPanel Grid.Column="0" Margin="0,0,14,0">
            <TextBlock Text="DeskMate 设置" Style="{StaticResource TitleTextStyle}" Margin="4,4,0,16" />

            <RadioButton Style="{StaticResource NavItemStyle}"
                         Content="通用"
                         IsChecked="{Binding IsGeneralPage, Mode=OneWay}"
                         Command="{Binding ShowGeneralCommand}" />
            <RadioButton Style="{StaticResource NavItemStyle}"
                         Content="外观"
                         IsChecked="{Binding IsAppearancePage, Mode=OneWay}"
                         Command="{Binding ShowAppearanceCommand}" />
            <RadioButton Style="{StaticResource NavItemStyle}"
                         Content="数据"
                         IsChecked="{Binding IsDataPage, Mode=OneWay}"
                         Command="{Binding ShowDataCommand}" />
        </StackPanel>

        <!-- 右侧内容 -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      Style="{StaticResource ThinScrollViewerStyle}">
            <StackPanel Margin="6,0,10,0">

                <!-- ============ 通用 ============ -->
                <StackPanel Visibility="{Binding IsGeneralPage, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="启动与快捷键" Style="{StaticResource SectionTextStyle}" />

                            <CheckBox Content="开机自启（写入当前用户的启动项）"
                                      Style="{StaticResource CheckStyle}"
                                      Margin="0,14,0,0"
                                      IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}" />

                            <TextBlock Text="全局快捷键" Style="{StaticResource BodyTextStyle}" Margin="0,18,0,6" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,0,0,8"
                                       Text="点一下输入框、再按下想要的组合键就能改（必须带 Ctrl / Alt / Shift / Win 之一）；按 Esc 取消，点「不绑定」清掉。搜索、启动台、文件夹面板各一个，互不影响。" />

                            <DockPanel Margin="0,3">
                                <Button DockPanel.Dock="Right"
                                        Content="不绑定"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Margin="10,0,0,0"
                                        Command="{Binding ClearHotkeySlotCommand}"
                                        CommandParameter="search" />
                                <TextBlock DockPanel.Dock="Left"
                                           Width="92"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource BodyTextStyle}"
                                           Text="搜索" />
                                <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                         Tag="search"
                                         IsReadOnly="True"
                                         Cursor="Hand"
                                         Text="{Binding HotkeyDisplay, Mode=OneWay}"
                                         PreviewMouseLeftButtonDown="OnHotkeyBoxClick" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="捕获中：按下组合键即可设置，Esc 取消"
                                       Visibility="{Binding IsCapturingSearch, Converter={StaticResource BoolToVis}}" />

                            <DockPanel Margin="0,3">
                                <Button DockPanel.Dock="Right"
                                        Content="不绑定"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Margin="10,0,0,0"
                                        Command="{Binding ClearHotkeySlotCommand}"
                                        CommandParameter="launcher" />
                                <TextBlock DockPanel.Dock="Left"
                                           Width="92"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource BodyTextStyle}"
                                           Text="启动台" />
                                <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                         Tag="launcher"
                                         IsReadOnly="True"
                                         Cursor="Hand"
                                         Text="{Binding LauncherHotkeyDisplay, Mode=OneWay}"
                                         PreviewMouseLeftButtonDown="OnHotkeyBoxClick" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="捕获中：按下组合键即可设置，Esc 取消"
                                       Visibility="{Binding IsCapturingLauncher, Converter={StaticResource BoolToVis}}" />

                            <DockPanel Margin="0,3">
                                <Button DockPanel.Dock="Right"
                                        Content="不绑定"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Margin="10,0,0,0"
                                        Command="{Binding ClearHotkeySlotCommand}"
                                        CommandParameter="folder" />
                                <TextBlock DockPanel.Dock="Left"
                                           Width="92"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource BodyTextStyle}"
                                           Text="文件夹面板" />
                                <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                         Tag="folder"
                                         IsReadOnly="True"
                                         Cursor="Hand"
                                         Text="{Binding FolderHotkeyDisplay, Mode=OneWay}"
                                         PreviewMouseLeftButtonDown="OnHotkeyBoxClick" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="捕获中：按下组合键即可设置，Esc 取消"
                                       Visibility="{Binding IsCapturingFolder, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,6,0,0"
                                       Text="启动台与文件夹面板默认不绑定，免得未经同意就抢走系统按键；不绑也能从 Dock 和托盘菜单进入。注册失败时托盘菜单里的「打开搜索」仍然是入口。" />

                            <TextBlock Text="语言" Style="{StaticResource BodyTextStyle}" Margin="0,18,0,6" />
                            <ComboBox Style="{StaticResource ComboStyle}"
                                      Width="220"
                                      HorizontalAlignment="Left"
                                      IsEnabled="False"
                                      Text="简体中文（v1.0 仅此一种）" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="启动台快捷方式文件夹" Style="{StaticResource SectionTextStyle}" />

                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,6,0,10"
                                       Text="这个文件夹里的 .lnk 与 .exe 会自动出现在启动台；启动台里点「＋ 添加应用」也是往这里放快捷方式。只能设置一个文件夹，留空则使用默认目录。" />

                            <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                     IsReadOnly="True"
                                     Text="{Binding LaunchpadFolderDisplay, Mode=OneWay}" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="选择文件夹"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding RequestPickLaunchpadFolderCommand}" />
                                <Button Content="用默认目录"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Margin="10,0,0,0"
                                        Command="{Binding ClearLaunchpadFolderCommand}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,10,0,0"
                                       Text="手动移除（右键「不在启动台显示」）的应用不会被自动同步加回来；需要时在启动台的「已隐藏」页恢复。" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ 外观 ============ -->
                <StackPanel Visibility="{Binding IsAppearancePage, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="主题" Style="{StaticResource SectionTextStyle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <RadioButton Style="{StaticResource TabPillStyle}"
                                             Content="浅色"
                                             IsChecked="{Binding ThemeOption, Converter={StaticResource Equals}, ConverterParameter=Light, Mode=OneWay}"
                                             Command="{Binding SetThemeCommand}"
                                             CommandParameter="Light" />
                                <RadioButton Style="{StaticResource TabPillStyle}"
                                             Content="深色"
                                             IsChecked="{Binding ThemeOption, Converter={StaticResource Equals}, ConverterParameter=Dark, Mode=OneWay}"
                                             Command="{Binding SetThemeCommand}"
                                             CommandParameter="Dark" />
                                <RadioButton Style="{StaticResource TabPillStyle}"
                                             Content="跟随系统"
                                             IsChecked="{Binding ThemeOption, Converter={StaticResource Equals}, ConverterParameter=System, Mode=OneWay}"
                                             Command="{Binding SetThemeCommand}"
                                             CommandParameter="System" />
                            </StackPanel>

                            <TextBlock Text="Dock 位置" Style="{StaticResource SectionTextStyle}" Margin="0,22,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <RadioButton Style="{StaticResource TabPillStyle}"
                                             Content="底部"
                                             IsChecked="{Binding DockPosition, Converter={StaticResource Equals}, ConverterParameter=Bottom, Mode=OneWay}"
                                             Command="{Binding SetDockPositionCommand}"
                                             CommandParameter="Bottom" />
                                <RadioButton Style="{StaticResource TabPillStyle}"
                                             Content="左侧"
                                             IsChecked="{Binding DockPosition, Converter={StaticResource Equals}, ConverterParameter=Left, Mode=OneWay}"
                                             Command="{Binding SetDockPositionCommand}"
                                             CommandParameter="Left" />
                                <RadioButton Style="{StaticResource TabPillStyle}"
                                             Content="右侧"
                                             IsChecked="{Binding DockPosition, Converter={StaticResource Equals}, ConverterParameter=Right, Mode=OneWay}"
                                             Command="{Binding SetDockPositionCommand}"
                                             CommandParameter="Right" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Dock 细节" Style="{StaticResource SectionTextStyle}" />

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="图标大小" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1"
                                        Minimum="24"
                                        Maximum="80"
                                        IsSnapToTickEnabled="False"
                                        VerticalAlignment="Center"
                                        Value="{Binding DockIconSize, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding DockIconSize}"
                                           Style="{StaticResource BodyTextStyle}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="背景不透明度" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1"
                                        Minimum="20"
                                        Maximum="100"
                                        IsSnapToTickEnabled="False"
                                        VerticalAlignment="Center"
                                        Value="{Binding DockOpacityPercent, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding DockOpacityPercent, StringFormat={}{0}%}"
                                           Style="{StaticResource BodyTextStyle}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <CheckBox Content="毛玻璃（柔和边框近似）"
                                      Style="{StaticResource CheckStyle}"
                                      Margin="0,18,0,0"
                                      IsChecked="{Binding BlurEnabled, Mode=TwoWay}" />
                            <CheckBox Content="自动隐藏 Dock（鼠标移到屏幕边缘唤出）"
                                      Style="{StaticResource CheckStyle}"
                                      Margin="0,10,0,0"
                                      IsChecked="{Binding AutoHideDock, Mode=TwoWay}" />
                            <CheckBox Content="贴桌面层模式（实验性：Dock 沉到图标层）"
                                      Style="{StaticResource CheckStyle}"
                                      Margin="0,10,0,0"
                                      IsChecked="{Binding DesktopLayerMode, Mode=TwoWay}" />

                            <CheckBox Content="让 Dock 贴住屏幕边缘（底部停靠时压在任务栏那条空白上）"
                                      Style="{StaticResource CheckStyle}"
                                      Margin="0,10,0,0"
                                      IsChecked="{Binding DockFlushToEdge, Mode=TwoWay}" />

                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,8,0,0"
                                       Text="只是把 Dock 自己挪到贴边，不动系统任何设置，任务栏照常工作。底部停靠时 Dock 会盖在任务栏那一条上：任务栏图标默认靠左，Dock 居中正好落在中间空白处，不挡图标；要完全顶替任务栏，请自己在 Windows 设置 → 个性化 → 任务栏 里打开「自动隐藏任务栏」。" />

                            <CheckBox Content="遮住任务栏左边（开始按钮与应用图标）"
                                      Style="{StaticResource CheckStyle}"
                                      Margin="0,16,0,0"
                                      IsChecked="{Binding TaskbarCoverEnabled, Mode=TwoWay}" />

                            <Grid Margin="0,10,0,0"
                                  Visibility="{Binding TaskbarCoverEnabled, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="遮罩宽度" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1"
                                        Minimum="160"
                                        Maximum="900"
                                        IsSnapToTickEnabled="False"
                                        VerticalAlignment="Center"
                                        Value="{Binding TaskbarCoverWidth, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding TaskbarCoverWidth, StringFormat={}{0}px}"
                                           Style="{StaticResource BodyTextStyle}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding TaskbarCoverEnabled, Converter={StaticResource BoolToVis}}"
                                       Text="DeskMate 另外画一条栏压在任务栏左边那一坨上面。它的填充是桌面壁纸在那一条上的原图（直接从桌面窗口 Progman 渲染的内容里裁，不模糊、也不随应用窗口变化，换壁纸半分钟跟一次），所以看上去就是桌面自然延伸到了屏幕底边，任务栏左边那一坨图标被原样盖在下面。只是挡住，不关闭：任务栏进程照跑，右边托盘、时钟、输入法照常可用；开始按钮与应用图标点不到了，但按 Win 键照常能开开始菜单（它从任务栏上方弹出，不在这条带子里）。视频/游戏全屏时遮罩和 Dock 一起消失。宽度自己拖，永远不会越过 Dock 的左沿。" />

                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,12,0,0"
                                       Text="说明：Dock 使用 WPF 分层透明窗口，系统不允许这类窗口做真实背景采样，因此「毛玻璃」是圆角 + 柔光的近似效果。" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ 数据 ============ -->
                <StackPanel Visibility="{Binding IsDataPage, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="配置与数据" Style="{StaticResource SectionTextStyle}" />

                            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,0" Text="配置文件" />
                            <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                     IsReadOnly="True"
                                     Margin="0,4,0,0"
                                     Text="{Binding ConfigPath, Mode=OneWay}" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="导出配置"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding RequestExportCommand}" />
                                <Button Content="导入配置"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Margin="10,0,0,0"
                                        ToolTip="会先自动备份现在的配置"
                                        Command="{Binding RequestImportCommand}" />
                                <Button Content="重置为默认"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="10,0,0,0"
                                        Click="OnResetClick" />
                            </StackPanel>

                            <TextBlock Text="数据在哪" Style="{StaticResource SectionTextStyle}" Margin="0,22,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="打开数据目录"
                                        Style="{StaticResource GhostButtonStyle}"
                                        ToolTip="config.json、应用缓存、启动统计、日志都在这儿"
                                        Command="{Binding OpenDataFolderCommand}" />
                                <Button Content="打开日志文件夹"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Margin="10,0,0,0"
                                        Command="{Binding OpenLogsFolderCommand}" />
                                <Button Content="清空启动统计"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Margin="10,0,0,0"
                                        ToolTip="「常用」页的排序依据，清空后重新开始积累"
                                        Command="{Binding ClearUsageStatsCommand}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,16,0,0"
                                       Text="DeskMate 只在数据目录内读写，不移动、改名或删除任何用户文件；卸载后删除该目录即可彻底清理（开机自启项需在设置里先关闭）。" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
