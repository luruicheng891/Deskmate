<Window x:Class="DeskMate.App.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskMate 提示"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsTabStop="False"
        ResizeMode="NoResize"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True">

    <!--
      非模态提示：只负责显示与点掉，不抢焦点，所以用户能一边看提示一边继续操作。
      刻意不做缩放动画 —— 浮层下面就是 Dock 图标，缩放期间落点会偏。
    -->
    <ItemsControl x:Name="Host" Margin="16">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Margin="0,0,0,8"
                        MaxWidth="480"
                        Padding="14,10"
                        CornerRadius="10"
                        Cursor="Hand"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1"
                        MouseLeftButtonUp="OnItemClick">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" Direction="270" />
                    </Border.Effect>
                    <DockPanel>
                        <Border DockPanel.Dock="Left"
                                Width="4"
                                Margin="0,0,10,0"
                                CornerRadius="2"
                                Background="{Binding Accent}" />
                        <Button DockPanel.Dock="Right"
                                Content="{Binding ActionLabel}"
                                Visibility="{Binding ActionVisibility}"
                                Style="{StaticResource GhostButtonStyle}"
                                FontSize="12"
                                Padding="10,3"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Focusable="False"
                                MouseLeftButtonUp="OnActionClick" />
                        <TextBlock Text="{Binding Message}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DockPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>
