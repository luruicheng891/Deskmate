<Window x:Class="DeskMate.App.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskMate 启动台"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">

    <Window.Resources>

        <DataTemplate x:Key="AppTileTemplate">
            <Button Width="118"
                    Height="104"
                    Margin="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Focusable="False"
                    Command="{Binding OpenCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cell"
                                Background="Transparent"
                                CornerRadius="12"
                                Padding="6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="64" Height="64">
                                    <Image Source="{Binding Icon}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding Icon, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                                    <Ellipse Fill="{DynamicResource SurfaceHoverBrush}"
                                             Visibility="{Binding Icon, Converter={StaticResource NullToVis}}" />
                                    <TextBlock Text="{Binding InitialLetter}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding Icon, Converter={StaticResource NullToVis}}" />
                                </Grid>
                                <TextBlock Text="{Binding Name}"
                                           Width="106"
                                           Margin="0,8,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxHeight="34"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>

                <Button.ContextMenu>
                    <ContextMenu MinWidth="170"
                                 Opened="OnTileMenuOpened"
                                 Closed="OnTileMenuClosed">
                        <!-- 命令都挂在磁贴自身（DataContext 就是这块磁贴），不要再绕 PlacementTarget -->
                        <MenuItem Header="打开" Command="{Binding OpenCommand}" />
                        <MenuItem Header="添加到 Dock" Command="{Binding AddToDockCommand}" />
                        <MenuItem Header="打开文件位置" Command="{Binding OpenLocationCommand}" />
                        <Separator />
                        <!-- 内置过滤规则拦不住的个性化噪声，由用户自己右键隐藏，随时可在「已隐藏」页恢复 -->
                        <MenuItem Header="不在启动台显示"
                                  Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                  Command="{Binding HideCommand}" />
                        <MenuItem Header="恢复显示"
                                  Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding RestoreCommand}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="RowPanelTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
        </ItemsPanelTemplate>

    </Window.Resources>

    <!--
      macOS Launchpad 式：不铺满全屏，窗口本身就是那块面板（尺寸与位置在代码里按屏幕 70% 算）。
      阴影单独一层，因为 Effect 会作用于整个子树，挂在内容层会把图标和文字一起糊掉。
    -->
    <Grid x:Name="Panel" Margin="26">
        <Border x:Name="ShadowBorder" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.5" Direction="270" />
            </Border.Effect>
        </Border>

        <!-- 毛玻璃的「玻璃」本身：面板后面那块屏幕被模糊后的样子，压在色调层底下 -->
        <Border x:Name="FrostBorder" CornerRadius="20" ClipToBounds="True" />

        <Border x:Name="SurfaceBorder" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="20" ClipToBounds="True">
            <Grid Margin="40,26,40,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 搜索框 -->
            <Border Grid.Row="0"
                    HorizontalAlignment="Center"
                    Width="620"
                    MaxWidth="620"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <TextBox x:Name="SearchBox"
                             DockPanel.Dock="Right"
                             Style="{StaticResource SearchBoxStyle}"
                             Text="{Binding Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </Border>

            <!-- 分组 Tab + 状态 -->
            <Grid Grid.Row="1" Margin="0,18,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <RadioButton Style="{StaticResource TabPillStyle}"
                                 Content="全部"
                                 IsChecked="{Binding IsAllTab, Mode=OneWay}"
                                 Command="{Binding ShowAllTabCommand}" />
                    <RadioButton Style="{StaticResource TabPillStyle}"
                                 Content="常用"
                                 IsChecked="{Binding IsFrequentTab, Mode=OneWay}"
                                 Command="{Binding ShowFrequentTabCommand}" />
                    <RadioButton Style="{StaticResource TabPillStyle}"
                                 Content="{Binding HiddenTabLabel}"
                                 IsChecked="{Binding IsHiddenTab, Mode=OneWay}"
                                 Command="{Binding ShowHiddenTabCommand}"
                                 Visibility="{Binding HasHidden, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Content="＋ 添加应用"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding RequestAddAppCommand}" />
                    <Button Content="刷新应用"
                            Style="{StaticResource GhostButtonStyle}"
                            Margin="10,0,0,0"
                            ToolTip="重新扫描开始菜单与注册表：刚装的软件不用重启 DeskMate（F5）"
                            Command="{Binding RefreshAppsCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Opacity="0.75" />
            </Grid>

            <!-- 应用网格：外层按行切分，配合 VirtualizingStackPanel 才能真正做 UI 虚拟化 -->
            <ItemsControl Grid.Row="2"
                          x:Name="RowsHost"
                          ItemsSource="{Binding Rows}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                <!-- ItemsControl 的默认模板没有 ScrollViewer（和 ListBox 不同），
                     所以光挂 ScrollViewer 附加属性没用，必须自己套一层 -->
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding Tiles}"
                                      ItemTemplate="{StaticResource AppTileTemplate}"
                                      ItemsPanel="{StaticResource RowPanelTemplate}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="3"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0"
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Opacity="0.7"
                       Text="Enter 打开第一项　·　F5 刷新应用　·　拖到 Dock 可固定　·　Esc 关闭" />
            </Grid>
        </Border>
    </Grid>
</Window>
