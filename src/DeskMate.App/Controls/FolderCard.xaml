<UserControl x:Class="DeskMate.App.Controls.FolderCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsTabStop="False"
             Focusable="False">

    <Border x:Name="Shell"
            Width="{Binding DataContext.CardItemWidth, RelativeSource={RelativeSource AncestorType=Window}}"
            MinHeight="98"
            Margin="0,0,12,12"
            CornerRadius="12"
            BorderThickness="1"
            Cursor="Hand">

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                    </Trigger>
                    <!-- 路径失效：标红边框，需求 M3 校验项 -->
                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                        <Setter Property="BorderBrush" Value="{DynamicResource InvalidBrush}" />
                    </DataTrigger>
                    <!-- 选中只换底色、不加粗边框：改 BorderThickness 会让整张卡片抖 1px -->
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 颜色标签条，没设颜色时整条隐藏 -->
            <Border Grid.Column="0"
                    CornerRadius="12,0,0,12"
                    Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                    Visibility="{Binding Color, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />

            <Grid Grid.Column="1">
                <StackPanel Orientation="Horizontal"
                            Margin="14,12,14,20">

                    <Grid Width="38" Height="38" Margin="0,0,12,0">
                        <TextBlock Text="&#xE8B7;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="30"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Color, Converter={StaticResource HexToBrush}}" />
                    </Grid>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="38"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{Binding RealPath}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="{Binding CountText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="　路径不存在"
                                       FontSize="11"
                                       Foreground="{DynamicResource InvalidBrush}"
                                       Visibility="{Binding IsValid, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 右下角两颗：＋ 在这个目录里新建，★ 收藏。放在卡片上而不是工具栏，
                     是因为「在哪建 / 收藏哪个」的答案就是这张卡片，用户不必先选中再去找按钮。 -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,8,6">
                    <Button Content="&#xE710;"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="在这个目录里新建：名字不带后缀建文件夹，带后缀（如 main.c）建文件"
                            Command="{Binding CreateCommand}"
                            IsEnabled="{Binding CanCreate}" />
                    <Button Content="{Binding StarGlyph}"
                            Margin="2,0,0,0"
                            ToolTip="{Binding StarTip}"
                            Command="{Binding ToggleFavoriteCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Border.ContextMenu>
            <ContextMenu MinWidth="184">
                <MenuItem Header="打开文件夹" Command="{Binding OpenCommand}" />
                <MenuItem Header="预览内部文件" Command="{Binding PreviewCommand}" />
                <MenuItem Header="在这个目录里新建…" Command="{Binding CreateCommand}" />
                <Separator />
                <MenuItem Header="加入收藏"
                          Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                          Command="{Binding ToggleFavoriteCommand}" />
                <MenuItem Header="从收藏移出"
                          Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"
                          Command="{Binding ToggleFavoriteCommand}" />
                <Separator />
                <MenuItem Header="重命名显示名" Command="{Binding RenameCommand}" />
                <!-- 只有真失效了才给这条路：不然菜单里多一项没用的噪声 -->
                <MenuItem Header="重新定位到新位置"
                          ToolTip="目录搬家或改名后，用它把引用指到新位置；磁盘上什么都不动"
                          Command="{Binding RelocateCommand}"
                          Visibility="{Binding IsValid, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                <MenuItem Header="颜色标签" ItemsSource="{Binding ColorOptions}">
                    <MenuItem.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="14"
                                        Height="14"
                                        CornerRadius="4"
                                        Background="{Binding Converter={StaticResource HexToBrush}}" />
                                <TextBlock Text="{Binding}" Margin="8,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </MenuItem.ItemTemplate>
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Command"
                                    Value="{Binding DataContext.ApplyColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>

                <MenuItem Header="清除颜色标签"
                          Command="{Binding ApplyColorCommand}"
                          CommandParameter="{x:Null}" />

                <MenuItem Header="换分组"
                          ItemsSource="{Binding GroupMenu}"
                          DisplayMemberPath="Name">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Command"
                                    Value="{Binding DataContext.ApplyGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>

                <Separator />
                <MenuItem Header="从 DeskMate 移除（不删除磁盘目录）" Command="{Binding RemoveCommand}" />
            </ContextMenu>
        </Border.ContextMenu>
    </Border>
</UserControl>
