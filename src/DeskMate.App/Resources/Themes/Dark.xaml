<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 暗色主题色板，键名与 Light.xaml 完全对应。 -->

    <SolidColorBrush x:Key="AccentBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E3A5F" />

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#10131A" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1F27" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#252B36" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#2E3542" />
    <SolidColorBrush x:Key="DividerBrush" Color="#242A34" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#1E3A5F" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA4B2" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#0B1220" />

    <SolidColorBrush x:Key="DockBackgroundBrush" Color="#E610131A" />
    <SolidColorBrush x:Key="LauncherScrimBrush" Color="#CC000000" />
    <SolidColorBrush x:Key="InvalidBrush" Color="#F87171" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />

</ResourceDictionary>
