root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{xaml,csproj,props,targets,pubxml,manifest,json,config,md}]
indent_size = 2

[*.cs]
# 命名空间：文件作用域
csharp_style_namespace_declarations = file_scoped:warning
# this. 限定
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
# var 优先
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
# 私有字段 _camelCase（规范九）
dotnet_naming_rule.private_fields_should_be_underbar_camel.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_underbar_camel.style = underbar_camel_style
dotnet_naming_rule.private_fields_should_be_underbar_camel.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underbar_camel_style.capitalization = camel_case
dotnet_naming_style.underbar_camel_style.required_prefix = _
# 异步方法后缀 Async
dotnet_naming_rule.async_methods_end_in_async.symbols = async_methods
dotnet_naming_rule.async_methods_end_in_async.style = end_in_async
dotnet_naming_rule.async_methods_end_in_async.severity = warning
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.end_in_async.required_suffix = Async
